# 开发环境主机清单模板。
#
# 用法：复制成 longzhu-hosts.dev.env，填好后在 Jenkins 里建 Secret file 凭据
# longzhu-dev-hosts 上传它。填好的文件不要提交（.gitignore 已排除 *.env），本仓是公开仓。
# 格式是 bash 的 KEY=VALUE（流水线会 source 它），值里有空格要加引号；不要写 <占位符>，
# 留空即可，缺必填项时流水线会明确报错。上传前请存成 LF 行尾。
#
# 键名：<产品>_<端>_<项>，产品与端取自 resources/com/longzhu/jenkins/products.json。
#   _HOST                   必填。目标机 IP；Jenkins 用凭据 longzhu-dev-ssh 以 root 登录
#   _SSH_PORT               SSH 端口，缺省 22
#   _KNOWN_HOSTS            建议填。ssh-keyscan -t ed25519 <IP> 的输出，填了才校验主机指纹
#   _PORT                   应用端口，缺省取产品清单 appPort
#   _BIND_ADDRESS           同机多端共用端口时本端的回环地址（127.0.0.1 至 127.0.0.254），
#                           必须与应用 properties 里的 server.address 一致
#   _HEALTH_PATH            健康检查路径，缺省取产品清单 healthPath
#   _HEALTH_SCHEME          http / https，缺省取产品清单 healthScheme
#   _HEALTH_TIMEOUT_SECONDS 健康检查最长等待秒数，缺省 180
#   _APP_DIR                部署目录，缺省 /opt/longzhu/<产品>-<端>
#   _SERVICE                systemd 服务名，缺省 <产品>-<端>
#   _BUILD_SKIP_TESTS       1 则构建时跳过单元测试，缺省 0（跑测试，不过不上线）
#   _BUILD_TIMEOUT_SECONDS  构建墙钟预算，缺省 2700
#   _MIN_FREE_MB            构建前要求的最小可用磁盘，缺省 5120
#   _MAVEN_OPTS / _NODE_OPTIONS  小内存机收紧堆，如 -Xmx1g / --max-old-space-size=1024
#   _MAVEN_MIRROR_URL       Maven 镜像，缺省华为云；填 none 不用镜像
#   _KEEP_RELEASES          保留的历史版本数，缺省 5
#   _GIT_FETCH_ATTEMPTS     git fetch 尝试次数，缺省 5；0 = 直接用 GitHub API + codeload tarball
#   _NET_MAX_ATTEMPTS       SSH 建连失败重试次数，缺省 3
#
# 数据库（clean database / init database 用）：<产品>_DB_HOST、<产品>_DB_NAME（必填）、<产品>_DB_PORT（缺省 3306）。

# ---- longzhu ----
# 两端同机：管理端占 8080、用户端占 8081（部署脚本以启动参数 --server.port 指定，不写进 properties），
# 由 Nginx 按域名转发（见 deploy/nginx/longzhu-dev.conf）。不设 _BIND_ADDRESS，应用监听全部地址。
# 目标机只有 2 GB 内存：构建时收紧 Maven 与 Node 的堆，并按 README 建 4 GB 交换分区。
LONGZHU_USER_HOST=
LONGZHU_USER_PORT=8081
LONGZHU_USER_HEALTH_PATH=/longzhu/health/readiness
LONGZHU_USER_HEALTH_SCHEME=http
LONGZHU_USER_KNOWN_HOSTS=
LONGZHU_USER_MAVEN_OPTS=-Xmx768m
LONGZHU_USER_NODE_OPTIONS=--max-old-space-size=1024
# 目标机连 github.com 的 git 通道常年超时，API 与 codeload 很快：直接走 tarball。
LONGZHU_USER_GIT_FETCH_ATTEMPTS=0

LONGZHU_ADMIN_HOST=
LONGZHU_ADMIN_PORT=8080
LONGZHU_ADMIN_HEALTH_PATH=/longzhu/health/readiness
LONGZHU_ADMIN_HEALTH_SCHEME=http
LONGZHU_ADMIN_KNOWN_HOSTS=
LONGZHU_ADMIN_MAVEN_OPTS=-Xmx768m
LONGZHU_ADMIN_NODE_OPTIONS=--max-old-space-size=1024
LONGZHU_ADMIN_GIT_FETCH_ATTEMPTS=0

# 数据库（clean database / init database 两个 Job 用）。
LONGZHU_DB_HOST=
LONGZHU_DB_PORT=3306
LONGZHU_DB_NAME=longzhu
